@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CUDAToolkit 11.8)

if(@MAGNETIC_COORDINATE_HAVE_NETCDF@)
  if(@MAGNETIC_COORDINATE_NETCDF_USES_PKGCONFIG@)
    find_dependency(PkgConfig)
    pkg_check_modules(MAGNETIC_COORDINATE_NETCDF REQUIRED IMPORTED_TARGET netcdf)
  else()
    find_dependency(netCDF)
  endif()
endif()
if(@MAGNETIC_COORDINATE_HAVE_HDF5@)
  if(@MAGNETIC_COORDINATE_HDF5_USES_PKGCONFIG@)
    find_dependency(PkgConfig)
    pkg_check_modules(MAGNETIC_COORDINATE_HDF5 REQUIRED IMPORTED_TARGET hdf5)
  else()
    find_dependency(HDF5 COMPONENTS C)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/magnetic-coordinate-targets.cmake")
